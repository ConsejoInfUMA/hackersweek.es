{
	"name": "@ceetsii/hackers-week-website",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.0",
		"@types/node": "^25.6.0",
		"mdsvex": "^0.12.7",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.10"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.0.0"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.5",
			"onFail": "download"
		}
	}
}
